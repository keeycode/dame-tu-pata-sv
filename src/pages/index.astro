---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import HowToHelp from '../components/HowToHelp.astro';
import AdoptionDogs from '../components/AdoptionDogs.astro';
import BankDonations from '../components/BankDonations.astro';
import SupplyDonations from '../components/SupplyDonations.astro';
import CollectionCenters from '../components/CollectionCenters.astro';
import EmotionalBanner from '../components/EmotionalBanner.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

import {
  getSiteSettings,
  getLandingPageData,
  getAdoptionDogs,
  getDonationAccounts,
  getSuppliesData,
  getCollectionCenters,
} from '../sanity/queries';

const siteSettings = await getSiteSettings();
const landingData = await getLandingPageData();
const adoptionDogs = await getAdoptionDogs();
const donationAccounts = await getDonationAccounts();
const suppliesData = await getSuppliesData();
const collectionCenters = await getCollectionCenters();
---

<Layout
  seo={landingData.seo}
  siteSettings={siteSettings}
>
  <!-- Barra de Navegación Sticky -->
  <Navbar
    logoUrl={siteSettings.logoUrl}
    organizationName={siteSettings.organizationName}
  />

  <!-- Contenido Principal -->
  <main class="w-full pt-20">
    <div class="flex flex-col w-full">
      <!-- 1. Hero (#inicio) -->
      <Hero
        badge={landingData.heroBadge}
        title={landingData.heroTitle}
        description={landingData.heroDescription}
        primaryCtaText={landingData.heroCtaPrimaryText}
        secondaryCtaText={landingData.heroCtaSecondaryText}
        imageUrl={landingData.heroImageUrl}
        imageAlt={landingData.heroImageAlt}
        communityText={landingData.heroCommunityText}
      />

      <!-- 2. Perritos en adopción (#adopciones) -->
      <AdoptionDogs
        dogs={adoptionDogs}
        whatsappNumber={siteSettings.whatsappNumber}
      />

      <!-- 3. Quiénes somos (#quienes-somos) -->
      <About
        badge={landingData.aboutBadge}
        title={landingData.aboutTitle}
        description={landingData.aboutDescription}
        pillars={landingData.pillars}
      />

      <!-- 4. Cómo puedes ayudar (#como-ayudar) -->
      <HowToHelp
        badge={landingData.howToHelpBadge}
        title={landingData.howToHelpTitle}
        description={landingData.howToHelpDescription}
        helpActions={landingData.helpActions}
      />

      <!-- 5. Cuentas para donaciones monetarias (#donaciones) -->
      <BankDonations
        accounts={donationAccounts}
      />

      <!-- 6. Donaciones en especie (#donaciones-especie) -->
      <SupplyDonations
        categories={suppliesData.categories}
        items={suppliesData.items}
      />

      <!-- 7. Centros de acopio (#centros-acopio) -->
      <CollectionCenters
        centers={collectionCenters}
      />

      <!-- 8. Bloque Emocional de Conversión -->
      <EmotionalBanner
        badge={landingData.bannerBadge}
        title={landingData.bannerTitle}
        description={landingData.bannerDescription}
        ctaText={landingData.bannerCtaText}
        imageUrl={landingData.bannerImageUrl}
        imageAlt={landingData.bannerImageAlt}
      />

      <!-- 9. Canales directos y Formulario (#contacto) -->
      <Contact
        settings={siteSettings}
      />
    </div>
  </main>

  <!-- Pie de Página Oficial -->
  <Footer
    settings={siteSettings}
  />
</Layout>
