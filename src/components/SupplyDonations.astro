---
// SupplyDonations.astro - Donaciones en Especie, Insumos Médicos y Alimentos
---

<section
  id="donaciones-especie"
  class="w-full py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto scroll-mt-24 rounded-3xl reveal-on-scroll"
  style="background-image: radial-gradient(ellipse at top right, rgba(246, 166, 35, 0.08) 0%, transparent 50%), radial-gradient(ellipse at bottom left, rgba(240, 75, 69, 0.05) 0%, transparent 50%), url('data:image/svg+xml,%3Csvg width=\'52\' height=\'26\' viewBox=\'0 0 52 26\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cpath d=\'M10 10c0-2.2 1.8-4 4-4s4 1.8 4 4-1.8 4-4 4-4-1.8-4-4zm26 0c0-2.2 1.8-4 4-4s4 1.8 4 4-1.8 4-4 4-4-1.8-4-4z\' fill=\'%23F6A623\' fill-opacity=\'0.04\'/%3E%3C/svg%3E');"
>
  <!-- Encabezado independiente en tono vinotinto institucional #6E1F1C -->
  <div class="w-full rounded-3xl overflow-hidden mb-8 shadow-md bg-primary-dark text-white p-6 sm:p-10 md:p-12 border border-neutral-border/40">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-xl text-left">
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white/20 text-white font-bold text-xs mb-3 border border-white/20 backdrop-blur-sm">
          <span class="material-symbols-outlined text-[15px]">medical_services</span>
          <span>Insumos y alimentos</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight">
          También puedes ayudarnos con lo que necesitan
        </h2>
      </div>
      <p class="text-sm sm:text-base text-white/80 max-w-md leading-relaxed text-left md:text-right">
        Los perritos bajo resguardo requieren alimentación adecuada, higiene y elementos de cuidado diario para su recuperación integral.
      </p>
    </div>
  </div>

  <!-- Barra de Filtros sobre fondo claro habitual -->
  <div class="mb-10 flex flex-wrap items-center justify-center gap-2.5 p-2">
    <button
      type="button"
      class="supply-filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-primary-cta text-white transition-all shadow-sm"
      data-category="all"
    >
      Todos los insumos
    </button>
    <button
      type="button"
      class="supply-filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-card-bg text-text-main/80 border border-neutral-border/40 hover:bg-soft-chip/40 transition-all"
      data-category="alimentacion"
    >
      Alimentación
    </button>
    <button
      type="button"
      class="supply-filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-card-bg text-text-main/80 border border-neutral-border/40 hover:bg-soft-chip/40 transition-all"
      data-category="higiene"
    >
      Higiene y descanso
    </button>
    <button
      type="button"
      class="supply-filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-card-bg text-text-main/80 border border-neutral-border/40 hover:bg-soft-chip/40 transition-all"
      data-category="prevencion"
    >
      Prevención
    </button>
    <button
      type="button"
      class="supply-filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-card-bg text-text-main/80 border border-neutral-border/40 hover:bg-soft-chip/40 transition-all"
      data-category="curacion"
    >
      Curación
    </button>
  </div>

  <!-- Items Grid (10 productos con espaciado y alineación mejorados) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="supplies-container">
    <!-- Alimentación 1 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-1" data-category="alimentacion">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-soft-chip text-primary-dark text-[11px] font-bold mb-3">Alimentación</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Royal Canin Puppy</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Para cachorros en proceso de desarrollo y lactantes sin madre.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Veterinarias / Tiendas</span>
        <span class="font-medium text-text-main/70">Enlace próximamente</span>
      </div>
    </div>

    <!-- Alimentación 2 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-2" data-category="alimentacion">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-soft-chip text-primary-dark text-[11px] font-bold mb-3">Alimentación</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Hills A/D Diet</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Alimento húmedo hipercalórico para animales convalecientes o desnutridos.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Veterinarias</span>
        <span class="font-medium text-text-main/70">Enlace próximamente</span>
      </div>
    </div>

    <!-- Alimentación 3 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-3" data-category="alimentacion">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-soft-chip text-primary-dark text-[11px] font-bold mb-3">Alimentación</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Royal Canin Recovery</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Fórmula de fácil ingesta para pacientes en proceso de recuperación.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Veterinarias</span>
        <span class="font-medium text-text-main/70">Enlace próximamente</span>
      </div>
    </div>

    <!-- Alimentación 4 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-4" data-category="alimentacion">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-soft-chip text-primary-dark text-[11px] font-bold mb-3">Alimentación</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Alimento Seco y Húmedo</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Croquetas para perros adultos y latitas de paté para administración de medicina.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Supermercados</span>
        <span class="font-medium text-accent-warm font-semibold">Aceptado en acopios</span>
      </div>
    </div>

    <!-- Higiene 1 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-1" data-category="higiene">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-[#E5DEC9] text-text-main text-[11px] font-bold mb-3">Higiene y Descanso</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Pads de Entrenamiento</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Almohadillas absorbentes para cachorros y perritos en recuperación inmóviles.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Comercios / Súper</span>
        <span class="font-medium text-text-main/70">Enlace próximamente</span>
      </div>
    </div>

    <!-- Higiene 2 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-2" data-category="higiene">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-[#E5DEC9] text-text-main text-[11px] font-bold mb-3">Higiene y Descanso</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Colchitas y Mantas</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Cobijas limpias para dar abrigo, confort y protección térmica en sus camas.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Donación directa</span>
        <span class="font-medium text-text-main/80">Limpias y en buen estado</span>
      </div>
    </div>

    <!-- Higiene 3 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-3" data-category="higiene">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-[#E5DEC9] text-text-main text-[11px] font-bold mb-3">Higiene y Descanso</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Toallitas y Bolsas</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Toallitas húmedas desinfectantes hipoalergénicas y bolsas para residuos sanitarios.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Uso diario</span>
        <span class="font-medium text-text-main/70">Enlace próximamente</span>
      </div>
    </div>

    <!-- Prevención 1 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-4" data-category="prevencion">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-accent-warm/20 text-primary-dark text-[11px] font-bold mb-3">Prevención</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Bravecto / Credelio</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Antipulgas y garrapatas masticables para la protección de perros rescatados.</p>
        <div class="mt-3 text-primary-cta text-[11px] font-bold flex items-center gap-1">
          <span class="material-symbols-outlined text-[13px]">info</span>
          <span>Seleccionar según peso sugerido</span>
        </div>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Veterinarias</span>
        <span class="font-medium text-text-main/70">Enlace próximamente</span>
      </div>
    </div>

    <!-- Curación 1 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-1" data-category="curacion">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-soft-chip text-primary-dark text-[11px] font-bold mb-3">Curación</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Vendas Coban</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Vendas autoadhesivas para fijar apósitos sin adherirse al pelaje.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Farmacias / Online</span>
        <span class="font-medium text-text-main/70">Enlace próximamente</span>
      </div>
    </div>

    <!-- Curación 2 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-2" data-category="curacion">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-soft-chip text-primary-dark text-[11px] font-bold mb-3">Curación</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Silvrstat & Skintegrity</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Hidrogeles y apósitos de plata para regeneración celular en lesiones dérmicas.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Insumo médico</span>
        <span class="font-medium text-text-main/70">Enlace próximamente</span>
      </div>
    </div>

    <!-- Curación 3 -->
    <div class="supply-card bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between h-full reveal-on-scroll stagger-3" data-category="curacion">
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-md bg-soft-chip text-primary-dark text-[11px] font-bold mb-3">Curación</span>
        <h3 class="text-base sm:text-lg font-bold text-primary-dark mb-2">Silver Alginate Dressing</h3>
        <p class="text-xs sm:text-sm text-text-main/75 leading-relaxed">Apósitos estériles para el tratamiento y curación de heridas.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-neutral-border/20 flex items-center justify-between text-text-main/60 text-xs">
        <span>Farmacias / Online</span>
        <span class="font-medium text-text-main/70">Enlace próximamente</span>
      </div>
    </div>
  </div>
</section>

<script>
  function initSupplyFilters() {
    const buttons = document.querySelectorAll('.supply-filter-btn');
    const cards = document.querySelectorAll('.supply-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        buttons.forEach((b) => {
          b.className =
            'supply-filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-card-bg text-text-main/80 border border-neutral-border/40 hover:bg-soft-chip/40 transition-all';
        });
        btn.className =
          'supply-filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-primary-cta text-white transition-all shadow-sm';

        cards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (category === 'all' || cardCategory === category) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  initSupplyFilters();
  document.addEventListener('astro:after-swap', initSupplyFilters);
</script>
