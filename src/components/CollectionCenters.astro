---
// CollectionCenters.astro - Centros de Acopio Aliados y Mapa Interactivo
import { collectionCenters } from '../data/collectionCenters';

const activeCenters = collectionCenters
  .filter((c) => c.activo)
  .sort((a, b) => a.orden - b.orden);
---

<section
  id="centros-acopio"
  class="w-full py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto scroll-mt-24 rounded-3xl reveal-on-scroll"
  style="background-image: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.75) 0%, transparent 75%), url('data:image/svg+xml,%3Csvg width=\'64\' height=\'64\' viewBox=\'0 0 64 64\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cpath d=\'M0 32h64M32 0v64\' stroke=\'%23C8BBAA\' stroke-width=\'0.75\' stroke-opacity=\'0.12\' stroke-dasharray=\'2 4\' fill=\'none\'/%3E%3Ccircle cx=\'32\' cy=\'32\' r=\'8\' stroke=\'%23C8BBAA\' stroke-width=\'0.5\' stroke-opacity=\'0.10\' fill=\'none\'/%3E%3C/svg%3E');"
>
  <!-- Encabezado independiente en tono vinotinto institucional #6E1F1C -->
  <div class="w-full rounded-3xl overflow-hidden mb-10 shadow-md bg-primary-dark text-white p-6 sm:p-10 md:p-12 border border-neutral-border/40">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-xl text-left">
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white/20 text-white font-bold text-xs mb-3 border border-white/20 backdrop-blur-sm">
          <span class="material-symbols-outlined text-[15px]">pin_drop</span>
          <span>Puntos físicos</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight">
          Encuentra un centro de acopio cerca de ti
        </h2>
      </div>
      <p class="text-sm sm:text-base text-white/80 max-w-md leading-relaxed text-left md:text-right">
        Establecimientos amigos donde puedes entregar tus donaciones en especie en sus horarios habituales. Cada aliado cuenta con un espacio reservado para recibir tu ayuda.
      </p>
    </div>
  </div>

  <!-- Grid de tarjetas de centros de acopio (Espaciado mejorado y alineación perfecta) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-12">
    {
      activeCenters.map((center, index) => (
        <div
          class={`bg-card-bg rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-border/30 flex flex-col justify-between hover:shadow-lg transition-all duration-200 h-full reveal-on-scroll stagger-${(index % 6) + 1}`}
        >
          <!-- Parte Superior: Info del Aliado -->
          <div class="flex-1 flex flex-col">
            <div class="flex items-start gap-3.5 mb-4">
              <div
                class="w-14 h-14 rounded-xl bg-[#F2EDE3] border border-neutral-border/40 flex flex-col items-center justify-center shrink-0 text-text-main/50 p-1 text-center group"
                title={`Espacio para logo de ${center.nombre}`}
              >
                <span class="material-symbols-outlined text-[24px] text-accent-warm">
                  {center.icon || 'storefront'}
                </span>
                <span class="text-[9px] font-bold text-text-main/60 uppercase tracking-tight leading-none mt-0.5">
                  Logo
                </span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 mb-1.5 flex-wrap">
                  <span class="px-2.5 py-0.5 rounded-full bg-[#E5DEC9] text-text-main text-[11px] font-bold truncate">
                    {center.zona}
                  </span>
                  {center.dias && (
                    <span class="inline-flex items-center gap-1 text-[11px] font-bold text-accent-warm shrink-0">
                      <span class="w-2 h-2 rounded-full bg-accent-warm"></span>
                      <span>{center.dias}</span>
                    </span>
                  )}
                </div>
                <h3 class="text-base sm:text-lg font-bold text-primary-dark leading-snug">
                  {center.nombre}
                </h3>
              </div>
            </div>

            <!-- Dirección -->
            <p class="text-xs sm:text-sm text-text-main/75 mb-4 leading-relaxed flex-1">
              {center.direccion}
            </p>

            {center.telefono && (
              <p class="text-xs text-primary-cta font-bold mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">phone</span>
                <a href={`tel:${center.telefono.replace(/\s+/g, '')}`} class="hover:underline">
                  {center.telefono}
                </a>
              </p>
            )}

            {center.horario && (
              <div class="bg-[#F2EDE3] px-3.5 py-2.5 rounded-xl text-text-main/80 text-xs mb-4 flex items-center gap-2 border border-neutral-border/30">
                <span class="material-symbols-outlined text-[17px] text-text-main/60">schedule</span>
                <span>{center.horario}</span>
              </div>
            )}
          </div>

          <!-- Parte Inferior: Botones de Acción perfectamente alineados -->
          <div class="mt-auto pt-4 border-t border-neutral-border/25 space-y-2.5">
            <div class="flex items-center gap-2">
              <a
                href={center.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 py-2.5 px-3 rounded-xl bg-[#F2EDE3] hover:bg-soft-chip text-primary-dark text-xs font-bold flex items-center justify-center gap-1.5 border border-neutral-border/40 transition-colors shadow-xs"
              >
                <span class="material-symbols-outlined text-[16px]">map</span>
                <span>Google Maps</span>
              </a>
              <a
                href={center.wazeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 py-2.5 px-3 rounded-xl bg-[#F2EDE3] hover:bg-soft-chip text-primary-dark text-xs font-bold flex items-center justify-center gap-1.5 border border-neutral-border/40 transition-colors shadow-xs"
              >
                <span class="material-symbols-outlined text-[16px]">navigation</span>
                <span>Waze</span>
              </a>
            </div>

            <button
              type="button"
              class="focus-center-btn w-full py-1.5 px-3 rounded-lg text-[11px] font-bold text-primary-dark/80 hover:text-primary-cta hover:bg-[#F2EDE3]/50 flex items-center justify-center gap-1 transition-colors"
              data-center-id={center.id}
            >
              <span class="material-symbols-outlined text-[14px] text-accent-warm">my_location</span>
              <span>Ubicar en el mapa interactivo</span>
            </button>
          </div>
        </div>
      ))
    }
  </div>

  <!-- MAPA INTERACTIVO REAL CON LEAFLET + OPENSTREETMAP (Sustituye al placeholder) -->
  <div class="w-full bg-white rounded-3xl p-4 sm:p-6 md:p-8 border border-neutral-border/40 shadow-sm reveal-on-scroll">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-neutral-border/30">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-soft-chip flex items-center justify-center text-primary-dark shadow-sm">
          <span class="material-symbols-outlined text-[24px]">explore</span>
        </div>
        <div>
          <h3 class="text-lg sm:text-xl font-extrabold text-primary-dark tracking-tight">
            Mapa Interactivo de Centros de Acopio
          </h3>
          <p class="text-xs sm:text-sm text-text-main/70">
            Haz clic en los marcadores para ver detalles y abrir tu ruta en Google Maps o Waze.
          </p>
        </div>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-soft-chip/60 text-primary-dark text-xs font-bold self-start sm:self-auto border border-neutral-border/30">
        <span class="w-2 h-2 rounded-full bg-[#F04B45] animate-pulse"></span>
        <span>5 Puntos aliados activos</span>
      </div>
    </div>

    <!-- Contenedor del Mapa -->
    <div
      id="leaflet-map"
      class="w-full h-[380px] sm:h-[440px] md:h-[500px] rounded-2xl border border-neutral-border/40 shadow-inner z-10 overflow-hidden"
    >
    </div>
  </div>
</section>

<script>
  import L from 'leaflet';
  import { collectionCenters } from '../data/collectionCenters';

  function initInteractiveMap() {
    const mapContainer = document.getElementById('leaflet-map');
    if (!mapContainer) return;

    // Prevenir reinicializaciones si ya tiene instancia previa
    if ((mapContainer as any)._leaflet_id) {
      return;
    }

    const activeCenters = collectionCenters
      .filter((c) => c.activo)
      .sort((a, b) => a.orden - b.orden);

    // Inicializar mapa centrado en el área metropolitana de San Salvador / Santa Tecla
    const map = L.map('leaflet-map', {
      scrollWheelZoom: false,
    }).setView([13.692, -89.245], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19,
    }).addTo(map);

    const markers: { [key: string]: L.Marker } = {};

    activeCenters.forEach((center) => {
      // Marcador personalizado con la identidad visual aprobada
      const customIcon = L.divIcon({
        className: 'custom-paw-marker',
        html: `
          <div class="relative group cursor-pointer" style="transform: translate(-50%, -100%);">
            <div class="w-10 h-10 rounded-full bg-[#6E1F1C] border-2 border-white shadow-xl flex items-center justify-center text-white transition-transform duration-200 hover:scale-115">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-white" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </div>
            <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2.5 h-2.5 bg-[#6E1F1C] rotate-45"></div>
          </div>
        `,
        iconSize: [40, 44],
        iconAnchor: [20, 44],
        popupAnchor: [0, -42],
      });

      const popupHtml = `
        <div class="p-1 font-sans text-[#0D1015] max-w-[260px]">
          <div class="flex items-center gap-1.5 mb-1.5">
            <span class="px-2 py-0.5 rounded-full bg-[#F6C7B7] text-[#6E1F1C] text-[10px] font-bold">${center.zona}</span>
            ${center.dias ? `<span class="text-[10px] font-bold text-[#F6A623]">${center.dias}</span>` : ''}
          </div>
          <h4 class="font-extrabold text-[#6E1F1C] text-[15px] leading-tight mb-1">${center.nombre}</h4>
          <p class="text-xs text-[#0D1015]/80 mb-2 leading-relaxed">${center.direccion}</p>
          ${center.horario ? `<div class="text-[11px] text-[#0D1015]/70 mb-3 bg-[#F2EDE3] px-2.5 py-1 rounded-lg">🕒 ${center.horario}</div>` : ''}
          <div class="flex items-center gap-2 pt-2 border-t border-[#C8BBAA]/30">
            <a href="${center.googleMapsUrl}" target="_blank" rel="noopener noreferrer" class="flex-1 py-1.5 px-2 rounded-lg bg-[#F2EDE3] hover:bg-[#F6C7B7] text-[#6E1F1C] text-xs font-bold text-center transition-colors">
              Google Maps
            </a>
            <a href="${center.wazeUrl}" target="_blank" rel="noopener noreferrer" class="flex-1 py-1.5 px-2 rounded-lg bg-[#F2EDE3] hover:bg-[#F6C7B7] text-[#6E1F1C] text-xs font-bold text-center transition-colors">
              Waze
            </a>
          </div>
        </div>
      `;

      const marker = L.marker([center.latitud, center.longitud], { icon: customIcon })
        .addTo(map)
        .bindPopup(popupHtml);

      markers[center.id] = marker;
    });

    // Ajustar el zoom para encuadrar todos los marcadores
    const group = L.featureGroup(Object.values(markers));
    map.fitBounds(group.getBounds().pad(0.12));

    // Conectar botones "Ubicar en el mapa" de las tarjetas
    document.querySelectorAll('.focus-center-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const centerId = btn.getAttribute('data-center-id');
        if (centerId && markers[centerId]) {
          const marker = markers[centerId];
          mapContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(() => {
            map.flyTo(marker.getLatLng(), 15, { duration: 1 });
            marker.openPopup();
          }, 300);
        }
      });
    });
  }

  // Ejecutar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInteractiveMap);
  } else {
    initInteractiveMap();
  }
  document.addEventListener('astro:after-swap', initInteractiveMap);
</script>
