---
// Contact.astro - Canales Directos y Formulario de Contacto vía WhatsApp
import { siteConfig } from '../data/siteConfig';

const whatsappNumber = siteConfig.whatsappNumber;
---

<section id="contacto" class="w-full py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto scroll-mt-24 reveal-on-scroll">
  <div
    class="bg-white rounded-3xl p-6 sm:p-10 md:p-12 border border-neutral-border/40 shadow-sm"
    style="background-image: radial-gradient(circle at 10% 15%, rgba(240, 75, 69, 0.04) 0%, transparent 40%), radial-gradient(circle at 90% 85%, rgba(110, 31, 28, 0.035) 0%, transparent 40%), url('data:image/svg+xml,%3Csvg width=\'32\' height=\'32\' viewBox=\'0 0 32 32\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Ccircle cx=\'16\' cy=\'16\' r=\'0.75\' fill=\'%23C8BBAA\' fill-opacity=\'0.12\'/%3E%3C/svg%3E'); box-shadow: 0 10px 35px -5px rgba(110, 31, 28, 0.06);"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Columna Izquierda: Información y Canales Oficiales -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-soft-chip text-primary-dark font-bold text-xs mb-3 border border-neutral-border/30">
            <span class="material-symbols-outlined text-[15px]">contact_support</span>
            <span>Canales directos</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-primary-dark tracking-tight leading-tight">
            Mantente cerca de Dame Tu Pata
          </h2>
          <p class="text-base text-text-main/80 mt-3 leading-relaxed">
            ¿Deseas información sobre el proceso de adopción, brindar un hogar temporal o coordinar un apoyo solidario? Con gusto te atenderemos.
          </p>
        </div>

        <div class="space-y-3">
          <!-- Instagram -->
          <div class="bg-[#F2EDE3]/70 rounded-2xl p-4 sm:p-4.5 border border-neutral-border/30 flex items-center justify-between hover:bg-[#F2EDE3] transition-colors">
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-soft-chip flex items-center justify-center text-primary-dark shadow-sm shrink-0">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div class="truncate">
                <p class="text-sm font-bold text-primary-dark">{siteConfig.socials.instagram.label}</p>
                <p class="text-xs text-text-main/70 truncate">{siteConfig.socials.instagram.username}</p>
              </div>
            </div>
            <a
              href={siteConfig.socials.instagram.url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-full bg-primary-cta text-white text-xs font-bold hover:bg-primary-dark transition-colors shadow-xs shrink-0 flex items-center gap-1"
            >
              <span>Seguir</span>
              <span class="material-symbols-outlined text-[14px]">arrow_outward</span>
            </a>
          </div>

          <!-- TikTok -->
          <div class="bg-[#F2EDE3]/70 rounded-2xl p-4 sm:p-4.5 border border-neutral-border/30 flex items-center justify-between hover:bg-[#F2EDE3] transition-colors">
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-soft-chip flex items-center justify-center text-primary-dark shadow-sm shrink-0">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                </svg>
              </div>
              <div class="truncate">
                <p class="text-sm font-bold text-primary-dark">{siteConfig.socials.tiktok.label}</p>
                <p class="text-xs text-text-main/70 truncate">{siteConfig.socials.tiktok.username}</p>
              </div>
            </div>
            <a
              href={siteConfig.socials.tiktok.url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-full bg-primary-cta text-white text-xs font-bold hover:bg-primary-dark transition-colors shadow-xs shrink-0 flex items-center gap-1"
            >
              <span>Seguir</span>
              <span class="material-symbols-outlined text-[14px]">arrow_outward</span>
            </a>
          </div>

          <!-- Facebook -->
          <div class="bg-[#F2EDE3]/70 rounded-2xl p-4 sm:p-4.5 border border-neutral-border/30 flex items-center justify-between hover:bg-[#F2EDE3] transition-colors">
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-soft-chip flex items-center justify-center text-primary-dark shadow-sm shrink-0">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </div>
              <div class="truncate">
                <p class="text-sm font-bold text-primary-dark">{siteConfig.socials.facebook.label}</p>
                <p class="text-xs text-text-main/70 truncate">{siteConfig.socials.facebook.username}</p>
              </div>
            </div>
            {siteConfig.socials.facebook.url ? (
              <a
                href={siteConfig.socials.facebook.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3.5 py-1.5 rounded-full bg-primary-cta text-white text-xs font-bold hover:bg-primary-dark transition-colors shadow-xs shrink-0 flex items-center gap-1"
              >
                <span>Seguir</span>
                <span class="material-symbols-outlined text-[14px]">arrow_outward</span>
              </a>
            ) : (
              <span class="px-3 py-1 rounded-full bg-white text-text-main/60 text-xs font-semibold border border-neutral-border/30 shrink-0">Próximamente</span>
            )}
          </div>

          <!-- WhatsApp Directo -->
          <div class="bg-[#F2EDE3]/70 rounded-2xl p-4 sm:p-4.5 border border-neutral-border/30 flex items-center justify-between hover:bg-[#F2EDE3] transition-colors">
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-soft-chip flex items-center justify-center text-primary-dark shadow-sm shrink-0">
                <span class="material-symbols-outlined text-[24px]">chat</span>
              </div>
              <div class="truncate">
                <p class="text-sm font-bold text-primary-dark">WhatsApp Directo</p>
                <p class="text-xs text-text-main/70 truncate">Atención personalizada</p>
              </div>
            </div>
            <a
              href={`https://wa.me/${whatsappNumber}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-full bg-primary-cta text-white text-xs font-bold hover:bg-primary-dark transition-colors shadow-xs shrink-0 flex items-center gap-1"
            >
              <span>Chatear</span>
              <span class="material-symbols-outlined text-[14px]">arrow_outward</span>
            </a>
          </div>

          <!-- Correo -->
          <div class="bg-[#F2EDE3]/70 rounded-2xl p-4 sm:p-4.5 border border-neutral-border/30 flex items-center justify-between hover:bg-[#F2EDE3] transition-colors">
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-soft-chip flex items-center justify-center text-primary-dark shadow-sm shrink-0">
                <span class="material-symbols-outlined text-[24px]">mail</span>
              </div>
              <div class="truncate">
                <p class="text-sm font-bold text-primary-dark">Correo Electrónico</p>
                <p class="text-xs text-text-main/70 truncate">{siteConfig.contactEmail}</p>
              </div>
            </div>
            <a
              href={`mailto:${siteConfig.contactEmail}`}
              class="px-3.5 py-1.5 rounded-full bg-white text-primary-dark hover:bg-soft-chip text-xs font-bold border border-neutral-border/40 transition-colors shadow-xs shrink-0 flex items-center gap-1"
            >
              <span>Escribir</span>
              <span class="material-symbols-outlined text-[14px]">mail</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Formulario con Envío Directo a WhatsApp -->
      <div class="lg:col-span-7 bg-[#F2EDE3]/50 rounded-2xl p-6 sm:p-8 md:p-10 border border-neutral-border/40">
        <h3 class="text-xl sm:text-2xl font-bold text-primary-dark mb-1.5">Envíanos un mensaje</h3>
        <p class="text-xs sm:text-sm text-text-main/70 mb-6">
          Completa el formulario y te abrirá un mensaje directo en WhatsApp con todos tus datos organizados.
        </p>

        <form id="contact-form" class="space-y-4" data-whatsapp={whatsappNumber}>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Nombre -->
            <div class="space-y-1.5">
              <label for="contact-name" class="text-xs font-bold text-text-main">Nombre completo *</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Tu nombre"
                class="w-full bg-white border border-neutral-border/40 px-4 py-3 rounded-xl text-sm text-text-main focus:outline-none focus:ring-2 focus:ring-primary-cta shadow-xs"
              />
            </div>

            <!-- Correo -->
            <div class="space-y-1.5">
              <label for="contact-email" class="text-xs font-bold text-text-main">Correo electrónico *</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="tu@correo.com"
                class="w-full bg-white border border-neutral-border/40 px-4 py-3 rounded-xl text-sm text-text-main focus:outline-none focus:ring-2 focus:ring-primary-cta shadow-xs"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Teléfono -->
            <div class="space-y-1.5">
              <label for="contact-phone" class="text-xs font-bold text-text-main">Teléfono / WhatsApp *</label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                required
                placeholder="+503 0000 0000"
                class="w-full bg-white border border-neutral-border/40 px-4 py-3 rounded-xl text-sm text-text-main focus:outline-none focus:ring-2 focus:ring-primary-cta shadow-xs"
              />
            </div>

            <!-- Asunto / Motivo -->
            <div class="space-y-1.5">
              <label for="contact-subject" class="text-xs font-bold text-text-main">Asunto / Motivo *</label>
              <select
                id="contact-subject"
                name="subject"
                required
                class="w-full bg-white border border-neutral-border/40 px-4 py-3 rounded-xl text-sm text-text-main focus:outline-none focus:ring-2 focus:ring-primary-cta shadow-xs"
              >
                <option value="">Selecciona un motivo</option>
                <option value="Adopción de un perrito">Quiero postularme para adoptar un perro</option>
                <option value="Ofrecer Hogar Temporal">Quiero brindar hogar temporal</option>
                <option value="Donación en especie o alimentos">Quiero donar insumos o alimento</option>
                <option value="Unirme como Voluntario">Quiero unirme como voluntario</option>
                <option value="Otras consultas generales">Otras consultas generales</option>
              </select>
            </div>
          </div>

          <!-- Mensaje -->
          <div class="space-y-1.5">
            <label for="contact-message" class="text-xs font-bold text-text-main">Mensaje *</label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Escribe aquí tu consulta o propuesta..."
              class="w-full bg-white border border-neutral-border/40 px-4 py-3 rounded-xl text-sm text-text-main focus:outline-none focus:ring-2 focus:ring-primary-cta resize-none shadow-xs"
            ></textarea>
          </div>

          <!-- Botón de Envío vía WhatsApp -->
          <button
            type="submit"
            class="w-full py-4 px-6 rounded-full bg-primary-cta text-white font-bold text-sm hover:bg-primary-dark transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2 mt-2"
          >
            <span class="material-symbols-outlined text-[20px]">chat</span>
            <span>Enviar mensaje por WhatsApp</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  function initWhatsAppForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Validación nativa de campos obligatorios
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
      const phoneInput = document.getElementById('contact-phone') as HTMLInputElement | null;
      const subjectSelect = document.getElementById('contact-subject') as HTMLSelectElement | null;
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

      const name = nameInput?.value.trim() || '';
      const email = emailInput?.value.trim() || '';
      const phone = phoneInput?.value.trim() || '';
      const subject = subjectSelect?.value.trim() || '';
      const message = messageInput?.value.trim() || '';

      // Validación estricta antes de abrir enlace
      if (!name || !email || !phone || !subject || !message) {
        form.reportValidity();
        return;
      }

      const whatsappNumber = form.getAttribute('data-whatsapp') || '50378449676';

      // Estructura exacta solicitada
      const structuredText =
`Hola, quiero ponerme en contacto con Dame Tu Pata.

Nombre: ${name}
Correo: ${email}
Teléfono: ${phone}
Asunto: ${subject}

Mensaje: ${message}`;

      const encodedText = encodeURIComponent(structuredText);
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedText}`;

      // Apertura segura de WhatsApp en nueva pestaña
      window.open(whatsappUrl, '_blank', 'noopener,noreferrer');

      // Limpieza del formulario
      form.reset();
    });
  }

  initWhatsAppForm();
  document.addEventListener('astro:after-swap', initWhatsAppForm);
</script>
