---
// Contact.astro - Canales Directos y Formulario de Contacto
---

<section id="contacto" class="w-full py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto scroll-mt-24">
  <div
    class="bg-white rounded-3xl p-6 sm:p-10 md:p-12 border border-neutral-border/40 shadow-sm"
    style="background-image: radial-gradient(circle at 10% 15%, rgba(240, 75, 69, 0.04) 0%, transparent 40%), radial-gradient(circle at 90% 85%, rgba(110, 31, 28, 0.035) 0%, transparent 40%), url('data:image/svg+xml,%3Csvg width=\'32\' height=\'32\' viewBox=\'0 0 32 32\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Ccircle cx=\'16\' cy=\'16\' r=\'0.75\' fill=\'%23C8BBAA\' fill-opacity=\'0.12\'/%3E%3C/svg%3E'); box-shadow: 0 10px 35px -5px rgba(110, 31, 28, 0.06);"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Columna Izquierda: Información y Canales Oficiales -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-soft-chip text-primary-dark font-bold text-xs mb-3 border border-neutral-border/30">
            <span class="material-symbols-outlined text-[15px]">contact_support</span>
            <span>Canales directos</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-primary-dark tracking-tight leading-tight">
            Mantente cerca de Dame Tu Pata
          </h2>
          <p class="text-base text-text-main/80 mt-3 leading-relaxed">
            ¿Deseas información sobre el proceso de adopción, brindar un hogar temporal o coordinar un apoyo solidario? Con gusto te atenderemos.
          </p>
        </div>

        <div class="space-y-3">
          <!-- Instagram -->
          <div class="bg-[#F2EDE3]/70 rounded-2xl p-4 border border-neutral-border/30 flex items-center justify-between hover:bg-[#F2EDE3] transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-soft-chip flex items-center justify-center text-primary-dark shadow-sm">
                <span class="material-symbols-outlined text-[22px]">photo_camera</span>
              </div>
              <div>
                <p class="text-sm font-bold text-primary-dark">Instagram</p>
                <p class="text-xs text-text-main/60">Canal oficial por confirmar</p>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full bg-white text-text-main/70 text-xs font-semibold border border-neutral-border/30">Pronto</span>
          </div>

          <!-- WhatsApp -->
          <div class="bg-[#F2EDE3]/70 rounded-2xl p-4 border border-neutral-border/30 flex items-center justify-between hover:bg-[#F2EDE3] transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-soft-chip flex items-center justify-center text-primary-dark shadow-sm">
                <span class="material-symbols-outlined text-[22px]">chat</span>
              </div>
              <div>
                <p class="text-sm font-bold text-primary-dark">WhatsApp Directo</p>
                <p class="text-xs text-text-main/60">Número oficial por confirmar</p>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full bg-white text-text-main/70 text-xs font-semibold border border-neutral-border/30">Pronto</span>
          </div>

          <!-- Correo -->
          <div class="bg-[#F2EDE3]/70 rounded-2xl p-4 border border-neutral-border/30 flex items-center justify-between hover:bg-[#F2EDE3] transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-soft-chip flex items-center justify-center text-primary-dark shadow-sm">
                <span class="material-symbols-outlined text-[22px]">mail</span>
              </div>
              <div>
                <p class="text-sm font-bold text-primary-dark">Correo Electrónico</p>
                <p class="text-xs text-text-main/60">Canal oficial por confirmar</p>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full bg-white text-text-main/70 text-xs font-semibold border border-neutral-border/30">Pronto</span>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Formulario Preparado para Integración -->
      <div class="lg:col-span-7 bg-[#F2EDE3]/50 rounded-2xl p-6 sm:p-8 border border-neutral-border/40">
        <h3 class="text-xl sm:text-2xl font-bold text-primary-dark mb-1">Envíanos un mensaje</h3>
        <p class="text-xs sm:text-sm text-text-main/70 mb-5">
          Completa el siguiente formulario para dudas sobre adopciones, voluntariado o centros de acopio.
        </p>

        <form id="contact-form" class="space-y-4" action="#" method="POST">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label for="contact-name" class="text-xs font-bold text-text-main">Nombre completo</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Tu nombre"
                class="w-full bg-white border border-neutral-border/40 px-4 py-2.5 rounded-xl text-sm text-text-main focus:outline-none focus:ring-2 focus:ring-primary-cta"
              />
            </div>
            <div class="space-y-1">
              <label for="contact-phone" class="text-xs font-bold text-text-main">Teléfono / WhatsApp</label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                required
                placeholder="+503 0000 0000"
                class="w-full bg-white border border-neutral-border/40 px-4 py-2.5 rounded-xl text-sm text-text-main focus:outline-none focus:ring-2 focus:ring-primary-cta"
              />
            </div>
          </div>

          <div class="space-y-1">
            <label for="contact-interest" class="text-xs font-bold text-text-main">Motivo de contacto</label>
            <select
              id="contact-interest"
              name="interest"
              class="w-full bg-white border border-neutral-border/40 px-4 py-2.5 rounded-xl text-sm text-text-main focus:outline-none focus:ring-2 focus:ring-primary-cta"
            >
              <option value="adopcion">Quiero postularme para adoptar un perro</option>
              <option value="hogar-temporal">Quiero brindar hogar temporal</option>
              <option value="donacion-especie">Quiero donar insumos o alimento</option>
              <option value="voluntariado">Quiero unirme como voluntario</option>
              <option value="otro">Otras consultas</option>
            </select>
          </div>

          <div class="space-y-1">
            <label for="contact-message" class="text-xs font-bold text-text-main">Mensaje</label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Escribe aquí tu consulta..."
              class="w-full bg-white border border-neutral-border/40 px-4 py-2.5 rounded-xl text-sm text-text-main focus:outline-none focus:ring-2 focus:ring-primary-cta resize-none"
            ></textarea>
          </div>

          <!-- Nota de integración pendiente (sin fingir envío falso en producción) -->
          <div class="p-3 bg-white/80 border border-neutral-border/40 rounded-xl text-xs text-text-main/75 flex items-center gap-2">
            <span class="material-symbols-outlined text-accent-warm text-[18px] shrink-0">info</span>
            <span>El canal de recepción directa por correo / backend se activará en la siguiente fase de integración.</span>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-6 rounded-full bg-primary-cta text-white font-bold text-sm hover:bg-primary-dark transition-all duration-200 shadow-md flex items-center justify-center gap-2"
          >
            <span class="material-symbols-outlined text-[20px]">send</span>
            <span>Enviar mensaje</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      form.addEventListener('submit', (e) => {
        // En esta fase evitamos simular envíos falsos no respaldados por backend
        e.preventDefault();
        alert('Formulario listo. La conexión con el backend de mensajería será integrada en la siguiente etapa.');
      });
    }
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
