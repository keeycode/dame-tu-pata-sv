---
// Footer.astro - Pie de Página Institucional en #6E1F1C
import { siteConfig } from '../data/siteConfig';
---

<footer class="w-full bg-primary-dark text-page-bg py-12 border-t border-primary-dark/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8 pb-8 border-b border-white/10">
      <!-- Logo Oficial, Leyenda y Redes Sociales Oficiales -->
      <div class="flex flex-col items-center md:items-start gap-3">
        <div class="flex items-center gap-3.5">
          <img
            src="/assets/images/emblema-dametupata.png"
            alt="Dame Tu Pata"
            width="64"
            height="64"
            class="h-14 sm:h-16 w-auto aspect-square object-contain rounded-full shadow-md"
          />
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight leading-tight">Dame Tu Pata</h2>
            <p class="text-xs sm:text-sm font-medium text-soft-chip">Rescate y Adopción Responsable en El Salvador</p>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-page-bg/80 max-w-sm text-center md:text-left leading-relaxed mt-2">
          Rescate y adopción de perros en El Salvador. Promoviendo el bienestar, la protección y la adopción responsable en nuestra comunidad.
        </p>

        <!-- Redes Sociales Oficiales -->
        <div class="flex items-center gap-2.5 mt-2">
          {siteConfig.socials.instagram.url && (
            <a
              href={siteConfig.socials.instagram.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Seguir en ${siteConfig.socials.instagram.label} (${siteConfig.socials.instagram.username})`}
              title={`${siteConfig.socials.instagram.label}: ${siteConfig.socials.instagram.username}`}
              class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors shadow-xs"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {siteConfig.socials.tiktok.url && (
            <a
              href={siteConfig.socials.tiktok.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Seguir en ${siteConfig.socials.tiktok.label} (${siteConfig.socials.tiktok.username})`}
              title={`${siteConfig.socials.tiktok.label}: ${siteConfig.socials.tiktok.username}`}
              class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors shadow-xs"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </a>
          )}
          <a
            href={`https://wa.me/${siteConfig.whatsappNumber}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contactar por WhatsApp"
            title="WhatsApp Oficial"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-colors shadow-xs"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
          </a>
        </div>
      </div>

      <!-- Enlaces Limpios de Navegación -->
      <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-xs sm:text-sm font-medium" aria-label="Navegación del pie de página">
        <a class="text-page-bg/80 hover:text-white transition-colors" href="#inicio">Inicio</a>
        <a class="text-page-bg/80 hover:text-white transition-colors" href="#quienes-somos">Quiénes somos</a>
        <a class="text-page-bg/80 hover:text-white transition-colors" href="#como-ayudar">Cómo ayudar</a>
        <a class="text-page-bg/80 hover:text-white transition-colors" href="#adopciones">Adopciones</a>
        <a class="text-page-bg/80 hover:text-white transition-colors" href="#donaciones">Donar</a>
        <a class="text-page-bg/80 hover:text-white transition-colors" href="#centros-acopio">Centros de acopio</a>
        <a class="text-page-bg/80 hover:text-white transition-colors" href="#contacto">Contacto</a>
      </nav>
    </div>

    <!-- Copyright y Crédito Oficial Keeycode -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left text-xs text-page-bg/60">
      <p class="text-xs text-page-bg/70">© Dame Tu Pata. Todos los derechos reservados.</p>
      <div class="inline-flex items-center gap-2.5 text-xs text-page-bg/80">
        <span class="font-medium">Desarrollado por</span>
        <a
          href="https://keeycode.com"
          target="_blank"
          rel="noopener noreferrer"
          title="Keeycode"
          class="inline-flex items-center hover:opacity-85 transition-opacity"
        >
          <img
            src="/assets/images/keeycode.png"
            alt="Keeycode"
            width="120"
            height="30"
            class="h-7 sm:h-8 w-auto object-contain brightness-110"
            style="height: 30px;"
          />
        </a>
      </div>
    </div>
  </div>
</footer>
