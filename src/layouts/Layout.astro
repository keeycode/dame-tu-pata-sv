---
import '../styles/global.css';
import 'leaflet/dist/leaflet.css';
import { siteConfig } from '../data/siteConfig';
import type { SanityLandingPage, SanitySiteSettings } from '../sanity/queries';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  seo?: SanityLandingPage['seo'];
  siteSettings?: SanitySiteSettings;
}

const {
  title = 'Dame Tu Pata — Rescate y Adopción en El Salvador',
  description = 'Dame Tu Pata promueve el rescate, rehabilitación y adopción responsable de perros en situación de vulnerabilidad en El Salvador. Juntos podemos brindarles un hogar seguro y lleno de cariño.',
  canonicalUrl = 'https://dametupatasv.keeycode.com/',
  ogImage = 'https://dametupatasv.keeycode.com/assets/images/og-image.jpg',
  seo,
  siteSettings,
} = Astro.props;

const resolvedTitle = seo?.metaTitle || title;
const resolvedDescription = seo?.metaDescription || description;
const resolvedCanonical = seo?.canonicalUrl || canonicalUrl;
const resolvedOgTitle = seo?.ogTitle || resolvedTitle;
const resolvedOgDesc = seo?.ogDescription || resolvedDescription;
const resolvedOgImage = seo?.ogImageUrl || ogImage;

const siteUrl = siteSettings?.siteUrl || 'https://dametupatasv.keeycode.com';
const orgName = siteSettings?.organizationName || 'Dame Tu Pata';
const logoUrl = siteSettings?.logoUrl || `${siteUrl}/assets/images/logo-dametupata.png`;
const faviconUrl = siteSettings?.logoUrl || '/assets/images/logo-dametupata.png';

const instagramUrl = siteSettings?.socials?.instagram?.url || siteConfig.socials.instagram.url;
const tiktokUrl = siteSettings?.socials?.tiktok?.url || siteConfig.socials.tiktok.url;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: orgName,
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: logoUrl,
        width: 512,
        height: 512,
      },
      description: 'Organización dedicada al rescate, cuidado y reubicación responsable de perritos en El Salvador.',
      areaServed: {
        '@type': 'Country',
        name: 'El Salvador',
      },
      sameAs: [
        instagramUrl,
        tiktokUrl,
      ].filter(Boolean),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: orgName,
      description: resolvedDescription,
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      inLanguage: 'es-SV',
    },
  ],
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={orgName} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDesc} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_SV" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDesc} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Google Fonts: Plus Jakarta Sans & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />


    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-page-bg text-text-main font-sans antialiased selection:bg-soft-chip selection:text-primary-dark min-h-screen">
    <slot />

    <!-- Script de Animaciones de Entrada (IntersectionObserver) -->
    <script>
      function setupScrollReveals() {
        const isMobile = window.matchMedia('(max-width: 767px)').matches;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealElements = document.querySelectorAll('.reveal-on-scroll');

        // En pantallas móviles (< 768px) o con reducción de movimiento:
        // Desactivar animaciones de scroll y evitar registrar en IntersectionObserver
        if (isMobile || prefersReducedMotion) {
          revealElements.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        // Desktop/Tablet: One-Shot IntersectionObserver
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                obs.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -30px 0px',
          }
        );

        revealElements.forEach((el) => observer.observe(el));
      }

      setupScrollReveals();
      document.addEventListener('astro:after-swap', setupScrollReveals);
    </script>
  </body>
</html>
