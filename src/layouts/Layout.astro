---
import '../styles/global.css';
import 'leaflet/dist/leaflet.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = 'Dame Tu Pata — Rescate y Adopción en El Salvador',
  description = 'Dame Tu Pata promueve el rescate, rehabilitación y adopción responsable de perros en situación de vulnerabilidad en El Salvador. Juntos podemos brindarles un hogar seguro y lleno de cariño.',
  canonicalUrl = 'https://dametupatasv.keeycode.com/',
  ogImage = 'https://dametupatasv.keeycode.com/assets/images/og-image.jpg',
} = Astro.props;

const siteUrl = 'https://dametupatasv.keeycode.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Dame Tu Pata',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/assets/images/logo-dametupata.png`,
        width: 512,
        height: 512,
      },
      description: 'Organización dedicada al rescate, cuidado y reubicación responsable de perritos en El Salvador.',
      areaServed: {
        '@type': 'Country',
        name: 'El Salvador',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Dame Tu Pata',
      description: description,
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      inLanguage: 'es-SV',
    },
  ],
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/images/logo-dametupata.png" />
    <link rel="apple-touch-icon" href="/assets/images/logo-dametupata.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dame Tu Pata" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_SV" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts: Plus Jakarta Sans & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />


    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-page-bg text-text-main font-sans antialiased selection:bg-soft-chip selection:text-primary-dark min-h-screen">
    <slot />

    <!-- Script de Animaciones de Entrada (IntersectionObserver) -->
    <script>
      function setupScrollReveals() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealElements = document.querySelectorAll('.reveal-on-scroll');

        if (prefersReducedMotion) {
          revealElements.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                obs.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        revealElements.forEach((el) => observer.observe(el));
      }

      setupScrollReveals();
      document.addEventListener('astro:after-swap', setupScrollReveals);
    </script>
  </body>
</html>
